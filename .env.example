# ── Vestta CRM ─────────────────────────────────────────────
# API key with scopes: properties:read, leads:ingest
# Without it the site runs on development fixtures (public/fixtures).
NUXT_VESTTA_API_KEY=
# Optional, defaults to https://api.vestta.io/v1
NUXT_VESTTA_BASE_URL=https://api.vestta.io/v1

# ── SMTP (form "Sell your home", and fallback for every lead if Vestta is down) ──
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Sender shown on notifications, e.g. "La Casa de Susana Web <web@lacasadesusana.es>"
NUXT_MAIL_FROM=
# Inbox that receives the notifications
NUXT_MAIL_TO=

# ── Site ───────────────────────────────────────────────────
# Canonical origin, used for hreflang, sitemap, OG and JSON-LD
NUXT_PUBLIC_SITE_URL=https://lacasadesusana.es
